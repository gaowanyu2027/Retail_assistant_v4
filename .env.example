# ============================================================
# 智能零售视频分析系统 — 环境变量模板
# 使用方法：复制本文件为 .env，填入真实值。
#   cp .env.example .env   （Windows: Copy-Item .env.example .env）
# 注意：.env 含真实密钥，已被 .gitignore 忽略，切勿提交。
# 本文件不含任何真实值，可安全进入 git。
# ============================================================

# ===== 必选 =====
# DeepSeek API Key（Agent 问答 / LLM 调用）
dazuoye_api=你的DeepSeek API Key

# MySQL root 密码（会话 / 表情 / 问答持久化；未配置则回退 SQLite）
mysql_root=你的MySQL密码

# 百度地图 服务端 AK + SK（竞品 / 商圈 / 地理编码 / 距离，sn 签名必需）
baidu_map_ak=你的百度地图AK
baidu_map_sk=你的百度地图SK

# ===== 可选 =====
# MySQL 连接
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root

# 人脸脱敏合规开关：设 1 时推帧/展示对人脸打码（个人信息保护法）
# SANITIZE_FACES=1

# Qdrant 接入模式：配置 QDRANT_URL 走 Server 模式（Docker/多进程/多机），
# 留空则用本地嵌入式（qdrant_data/，仅单进程）
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# 本地向量库目录（仅嵌入式模式使用）
# QDRANT_PATH=qdrant_data/

# 本地语音推理设备（cpu / cuda）
# SHERPA_ONNX_PROVIDER=cpu

# 百度官方 MCP 叠加（设 1 启用 14 个通用地图工具）
# BAIDU_MCP_ENABLED=1

# Langfuse 可观测（Public + Secret 两个 key 齐全才启用 Trace）
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# ===== 登录鉴权（可选）=====
# 初始 root 密码：**仅在首次启动（还没有 data/auth.db）时用于创建 root 账号**，
# 之后改它不会影响任何已有密码。不设则随机生成并打印到启动终端。
# 注意：必须 ≥8 位、非弱口令，否则会被拒绝并回退为随机口令。
# AUTH_ROOT_PASSWORD=请改成你自己的强密码

# 初始 root 用户名（默认 root）
# AUTH_ROOT_USERNAME=root

# 关闭登录校验（仅本地调试/自动化测试用，切勿在生产开启）
# AUTH_ENABLED=0

# 会话有效期（小时，默认 12）
# AUTH_SESSION_HOURS=12

# 登录限流：窗口内失败次数上限 / 窗口秒数 / 锁定时长秒数
# AUTH_MAX_FAILED_ATTEMPTS=5
# AUTH_FAILED_WINDOW_SECONDS=900
# AUTH_LOCKOUT_SECONDS=300

# 口令策略：最小长度（默认 8）
# AUTH_MIN_PASSWORD_LEN=8

# 会话 Cookie 的 Secure 标志：auto（默认，按协议自动）/ 1 / 0
# AUTH_COOKIE_SECURE=auto

# 跨域白名单（默认不开启跨域；确需跨域前端时配置，逗号分隔）
# AUTH_CORS_ORIGINS=http://localhost:5173

# 接口文档是否公开（默认 0=需登录）
# AUTH_PUBLIC_DOCS=0