        "kind": "rtsp",
        "url": "rtsp://192.168.10.20:554/s"
      },
      "expect": {
        "ok": {
          "kind": "rtsp",
          "legacy_action": "start_file",
          "params": {
            "file_path": "rtsp://192.168.10.20:554/s"
          },
          "echo": {
            "kind": "rtsp",
            "url": "rtsp://192.168.10.20:554/s"
          }
        }
      }
    },
    {
      "in": {
        "kind": "rtsp",
        "url": "rtsp://169.254.169.254/x"
      },
      "expect": {
        "error": "host_blocked"
      }
    },
    {
      "in": {
        "kind": "rtsp",
        "url": "rtsp://127.0.0.1/x"
      },
      "expect": {
        "error": "host_blocked"
      }
    },
    {
      "in": {
        "kind": "rtsp",
        "url": "rtsp://8.8.8.8/x"
      },
      "expect": {
        "error": "host_blocked"
      }
    },
    {
      "in": {
        "kind": "rtsp"
      },
      "expect": {
        "error": "bad_request"
      }
    },
    {
      "in": {
        "kind": "nope"
      },
      "expect": {
        "error": "unsupported_kind"
      }
    },
    {
      "in": null,
      "expect": {
        "error": "bad_request"
      }
    }
  ],
  "mask_credentials": [
    {
      "in": "rtsp://admin:secret@192.168.10.20:554/s",
      "expect": {
        "ok": "rtsp://***:***@192.168.10.20:554/s"
      }
    },
    {
      "in": "/app/data/x.mp4",
      "expect": {
        "ok": "/app/data/x.mp4"
      }
    }
  ],
  "echo_for_legacy": [
    {
      "action": "start_file",
      "params": {
        "file_path": "/x.mp4"
      },
      "expect": {
        "ok": {
          "kind": "file",
          "path": "/x.mp4"
        }
      }
    },
    {
      "action": "start_client_camera",
      "params": {},
      "expect": {
        "ok": {
          "kind": "client"
        }
      }
    },
    {
      "action": "ping",
