.page { padding-bottom: 40rpx; }
.toolbar { display: flex; flex-direction: column; gap: 12rpx; padding: 20rpx; }
.search-row { display: flex; align-items: center; gap: 12rpx; }
.search-input { flex: 1; background: #f2f4f8; border-radius: 12rpx; height: 64rpx; padding: 0 20rpx; font-size: 26rpx; }
.error-tip { background: #fdecea; color: #d64545; border-radius: 12rpx; margin: 20rpx; padding: 20rpx; font-size: 26rpx; }
.loading-tip { text-align: center; color: #9aa5b5; padding: 60rpx 0; font-size: 26rpx; }
.empty { color: #9aa5b5; font-size: 24rpx; text-align: center; padding: 24rpx 0; }

.section-title { font-size: 26rpx; font-weight: 600; margin: 16rpx 20rpx; }
.session-item { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.session-item:last-child { border-bottom: none; }
.s-main { flex: 1; }
.s-title { font-size: 28rpx; font-weight: 500; }
.s-title.cur { color: #3b82f6; }
.s-meta { font-size: 20rpx; color: #9aa5b5; margin-top: 4rpx; }
.s-del { font-size: 24rpx; color: #d64545; margin-left: 16rpx; padding: 8rpx 12rpx; }
.s-act { font-size: 24rpx; color: #3b82f6; margin-left: 16rpx; padding: 8rpx 12rpx; }

/* 历史消息 */
.history-card { margin-top: 16rpx; }
.h-close { float: right; color: #9aa5b5; font-size: 22rpx; }
.history-item { padding: 14rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.history-item:last-child { border-bottom: none; }
.h-row { display: flex; margin: 6rpx 0; }
.h-tag { flex-shrink: 0; background: #eef3fb; color: #3b82f6; font-size: 20rpx; border-radius: 6rpx; padding: 2rpx 10rpx; margin-right: 10rpx; height: fit-content; }
.h-tag.ans { background: #f2f0fb; color: #7a5af6; }
.h-body { flex: 1; font-size: 26rpx; line-height: 1.5; }
.h-meta { font-size: 20rpx; color: #9aa5b5; margin: 4rpx 0 0 36rpx; }

.search-item { padding: 14rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.search-item:last-child { border-bottom: none; }
.s-q { font-size: 26rpx; font-weight: 500; margin-bottom: 4rpx; }
.s-a { font-size: 22rpx; color: #5a6b7d; line-height: 1.5; max-height: 88rpx; overflow: hidden; }
