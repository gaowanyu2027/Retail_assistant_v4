.page {
  padding-bottom: 40rpx;
}

.error-tip {
  background: #fdecea;
  color: #d64545;
  border-radius: 12rpx;
  margin: 20rpx;
  padding: 20rpx;
  font-size: 26rpx;
}

.loading-tip {
  text-align: center;
  color: #9aa5b5;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.empty {
  color: #9aa5b5;
  font-size: 24rpx;
  padding: 12rpx 0;
  text-align: center;
}

/* 告警 */
.alert-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.alert-item {
  display: flex;
  flex-direction: column;
}

.alert-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.alert-num.danger {
  color: #d64545;
}

.alert-num.warn {
  color: #f59e0b;
}

.alert-label {
  font-size: 22rpx;
  color: #9aa5b5;
  margin-top: 4rpx;
}

/* 热度排行 */
.rank-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-no {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #eef3fb;
  color: #3b82f6;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
}

.rank-dwell {
  color: #9aa5b5;
  font-size: 22rpx;
  margin-right: 16rpx;
}

.rank-visit {
  color: #1f2d3d;
  font-size: 26rpx;
  font-weight: 600;
}

/* 转化率 */
.zone-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}

.zone-item:last-child {
  border-bottom: none;
}

.zone-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.zone-name {
  font-size: 28rpx;
  font-weight: 600;
}

.zone-quadrant {
  font-size: 22rpx;
  font-weight: 600;
}

.zone-metrics {
  display: flex;
  gap: 24rpx;
  color: #9aa5b5;
  font-size: 22rpx;
  margin: 8rpx 0;
}

.zone-diagnosis {
  font-size: 24rpx;
  color: #2c3e50;
  margin: 4rpx 0;
}

.zone-suggestion {
  font-size: 24rpx;
  color: #3b82f6;
}

.summary-text {
  margin-top: 12rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 24rpx;
  color: #5a6b7d;
  line-height: 1.6;
}

/* 汇报 */
.report-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}

.report-item:last-child {
  border-bottom: none;
}

.report-summary {
  font-size: 24rpx;
  color: #2c3e50;
  line-height: 1.6;
}

.report-time {
  font-size: 20rpx;
  color: #9aa5b5;
  margin-top: 6rpx;
}
