.page { padding-bottom: 40rpx; }
.error-tip { background: #fdecea; color: #d64545; border-radius: 12rpx; margin: 20rpx; padding: 20rpx; font-size: 26rpx; }

.cam-row { white-space: nowrap; padding: 16rpx; }
.cam-tab { display: inline-block; background: #f2f4f8; color: #5a6b7d; border-radius: 24rpx; padding: 10rpx 24rpx; margin-right: 14rpx; font-size: 24rpx; }
.cam-tab.on { background: #3b82f6; color: #fff; }

.video-wrap { position: relative; margin: 0 20rpx; background: #000; border-radius: 12rpx; overflow: hidden; }
.video-canvas { width: 100%; height: 380px; display: block; background: #0f1923; }
.video-status { position: absolute; left: 12rpx; bottom: 10rpx; color: #fff; font-size: 20rpx; background: rgba(0,0,0,.6); padding: 4rpx 12rpx; border-radius: 8rpx; }

.mod-tabs { white-space: nowrap; }
.mod-tab { display: inline-block; background: #f2f4f8; color: #5a6b7d; border-radius: 20rpx; padding: 8rpx 20rpx; margin-right: 12rpx; font-size: 22rpx; }
.mod-tab.on { background: #eef3fb; color: #3b82f6; }

.mod-data { margin-top: 16rpx; }
.kv { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 1rpx solid #f2f4f8; font-size: 24rpx; }
.kv:last-child { border-bottom: none; }
.k { color: #9aa5b5; }
.v { font-weight: 600; }
.empty { color: #9aa5b5; font-size: 24rpx; display: block; padding: 20rpx 0; }
