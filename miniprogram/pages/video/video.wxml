<view class="page">
  <view class="error-tip" wx:if="{{error}}">{{error}}</view>

  <!-- 摄像头切换 -->
  <scroll-view class="cam-row" scroll-x>
    <view class="cam-tab {{activeCamera==item.id ? 'on' : ''}}"
      wx:for="{{cameras}}" wx:key="id" wx:for-item="item"
      data-cam="{{item.id}}" bindtap="onSwitchCamera">{{item.name}}</view>
  </scroll-view>

  <!-- 视频画面 -->
  <view class="video-wrap">
    <canvas type="2d" id="video" class="video-canvas"></canvas>
    <view class="video-status">{{wsStatus}} | 帧 {{frameId}}</view>
  </view>

  <!-- 该摄像头启用的模块数据 -->
  <view class="card mod-card" wx:if="{{activeCamera}}">
    <scroll-view class="mod-tabs" scroll-x>
      <view class="mod-tab {{moduleName==item ? 'on' : ''}}"
        wx:for="{{enabledForActive}}" wx:key="*this" wx:for-item="item"
        data-mod="{{item}}" bindtap="onPickModule">{{item}}</view>
    </scroll-view>
    <view class="mod-data" wx:if="{{moduleRows.length}}">
      <view class="kv" wx:for="{{moduleRows}}" wx:key="label">
        <text class="k">{{item.label}}</text>
        <text class="v">{{item.value}}</text>
      </view>
      <text class="empty" wx:if="{{!moduleRows.length}}">暂无数据（未接入视频流）</text>
    </view>
  </view>
</view>
