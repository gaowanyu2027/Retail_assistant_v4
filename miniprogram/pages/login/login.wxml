<view class="login-page">
  <view class="login-card">
    <view class="login-title">智能零售分析系统</view>
    <view class="login-sub">请登录后使用（账号由平台管理员分配）</view>

    <view class="field">
      <view class="label">用户名</view>
      <input class="input" value="{{username}}" placeholder="请输入用户名"
             confirm-type="next" bindinput="onInputUsername" />
    </view>

    <view class="field">
      <view class="label">密码</view>
      <input class="input" value="{{password}}" password="{{true}}" placeholder="请输入密码"
             confirm-type="done" bindinput="onInputPassword" bindconfirm="onSubmit" />
    </view>

    <view class="error" wx:if="{{error}}">{{error}}</view>

    <button class="btn-login" loading="{{loading}}" bindtap="onSubmit">
      {{loading ? '登录中…' : '登 录'}}
    </button>

    <view class="hint">首次部署：账号密码见服务端启动终端打印的「首次启动」提示；若已配置环境变量 AUTH_ROOT_PASSWORD 则使用该密码。</view>
  </view>
</view>
